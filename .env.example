# ============================================================
# Onuri Studio — 환경변수 예시
# 복사: cp .env.example .env.local
# ============================================================

# ─── 도메인 (Phase 1 필수) ────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Onuri Studio"

# ─── Supabase (Phase 1 필수) ──────────────────────────────────
# https://supabase.com/dashboard 에서 프로젝트 생성 후 Settings > API에서 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Yjs Realtime (Phase 4) ───────────────────────────────────
# 드라이버 결정 시점에 활성화 (O-008)
NEXT_PUBLIC_YJS_WS_URL=

# ─── 보안 (Phase 6) ───────────────────────────────────────────
RATE_LIMIT_REDIS_URL=

# ─── SSO (Phase 7+, MVP에선 빈 값 OK) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Google Workspace (Phase 8+, D-018) ──────────────────────
# D-018 Phase 8b 활성: drive.file scope 는 GoogleSignInButton 의 signInWithOAuth
# options 에서 직접 전달 (Supabase Dashboard 의 Additional Scopes 필드는 신 UI 에서 제거됨).
# 본 변수는 참고용 — 실제 사용 안 함.
GOOGLE_WORKSPACE_SCOPES="drive.file"
# (선택) 장기 server-side token 보관 시 사용. 현재는 client-side 만 사용해서 미사용.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
# Google Picker SDK + Drive API 호출용 API key.
# Google Cloud Console → APIs & Services → Credentials → API key 생성.
# 반드시 HTTP referrers + API restrictions (Drive API + Picker API) 설정.
NEXT_PUBLIC_GOOGLE_API_KEY=
# Google Cloud Project Number — Picker SDK 의 setAppId 에 필수 (drive.file scope 사용 시).
# 없으면 Picker 선택한 파일이 후속 Drive API 호출에서 404. 위 GOOGLE_CLIENT_ID 의
# prefix 숫자 (예: "648962576577-xxxx.apps.googleusercontent.com" → "648962576577").
# Google Cloud Console 좌측 "프로젝트 설정" 또는 대시보드 좌상단에서도 확인 가능.
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=

# ─── 이메일 매직 링크 (Phase 9, MVP에선 빈 값 OK) ─────────────
# Phase 9 도메인 인증 후 활성화
RESEND_API_KEY=
EMAIL_FROM=
# 예: noreply@onuri.studio
